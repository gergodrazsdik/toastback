#!/bin/sh
# toastback notify-send wrapper — generated by `toastback.exe install` (wrapper v1, toastback {{VERSION}})
# Shows notify-send's notifications as Windows toasts: `toastback notify-send --help`.
# To keep your distro's own notify-send, run `toastback install --no-notify-send` (removes this file).
exec "$HOME/.local/bin/toastback" notify-send "$@"
