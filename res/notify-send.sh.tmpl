#!/bin/sh
# toastback notify-send wrapper — generated by `toastback.exe install` (wrapper v2, toastback {{VERSION}})
# Shows notify-send's notifications as Windows toasts: `toastback notify-send --help`.
# To keep your distro's own notify-send, run `toastback install --no-notify-send` (removes this file).
tb="$HOME/.local/bin/toastback"
case " $* " in
*-fd*) ;;
*) exec "$tb" notify-send "$@" ;;
esac
# --id-fd and --selected-action-fd name this process's file descriptors, which the Windows exe
# can't reach: it prints `out TEXT` and `fd N TEXT` lines instead, delivered here.
{
  "$tb" notify-send --toastback-records "$@"
  echo "exit $?"
} | {
  rc=1
  while IFS= read -r line; do
    case $line in
    "out "*) printf '%s\n' "${line#out }" ;;
    "fd "*)
      rest=${line#fd }
      fd=${rest%% *}
      text=${rest#* }
      case $fd in
      '' | *[!0-9]*) ;;
      *) printf '%s\n' "$text" >&"$fd" ;;
      esac
      ;;
    "exit "*) rc=${line#exit } ;;
    esac
  done
  exit "$rc"
}
