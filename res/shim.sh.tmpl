#!/usr/bin/env bash
# toastback WSL shim — generated by `toastback.exe install` (shim v1, toastback {{VERSION}})
# Regenerate:  toastback.exe shim > ~/.local/bin/toastback
TOASTBACK_WIN_EXE='{{WIN_EXE_PATH}}'
exe="${TOASTBACK_EXE:-$(wslpath -u "$TOASTBACK_WIN_EXE")}"
exec "$exe" --distro "$WSL_DISTRO_NAME" --user "$(id -un)" --cwd "$PWD" "$@"
