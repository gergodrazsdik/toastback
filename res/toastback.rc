// Resources: icon, manifest, version info. VER_* macros come from build.rs.
#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", L"Gerg\x0151 Drazsdik"
      VALUE "FileDescription", "toastback: async Windows toasts with callbacks"
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", "toastback"
      VALUE "LegalCopyright", L"Copyright (C) 2026 Gerg\x0151 Drazsdik. Licensed under GPL-3.0-or-later."
      VALUE "OriginalFilename", "toastback.exe"
      VALUE "ProductName", "toastback"
      VALUE "ProductVersion", VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
